{
  "name": "@escrow/api",
  "version": "0.1.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "DATABASE_URL=\"${DATABASE_URL:-postgres://escrow:escrow@localhost:5432/escrow}\" ts-node-dev --respawn src/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/server.js",
    "migrate": "ts-node src/db/migrate.ts",
    "test": "DATABASE_URL=\"${TEST_DATABASE_URL:-postgres://escrow:escrow@localhost:5432/escrow_test}\" EVIDENCE_DIR=\"${EVIDENCE_DIR:-/tmp/goal27-test-evidence}\" jest --runInBand",
    "worker": "node dist/queue/worker-main.js",
    "seed": "DATABASE_URL=\"${DATABASE_URL:-postgres://escrow:escrow@localhost:5432/escrow}\" ts-node src/db/seed.ts"
  },
  "dependencies": {
    "@escrow/shared": "0.1.0",
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
